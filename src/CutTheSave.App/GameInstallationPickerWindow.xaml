<Window x:Class="CutTheSave.App.GameInstallationPickerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="选择游戏位置" Width="760" Height="430" WindowStartupLocation="CenterOwner" Background="{DynamicResource PageBackgroundBrush}">
    <Window.Style><Style TargetType="Window" BasedOn="{StaticResource {x:Type Window}}" /></Window.Style>
    <DockPanel Margin="24">
        <TextBlock x:Name="TitleText" DockPanel.Dock="Top" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8" Text="选择游戏位置" />
        <TextBlock x:Name="HelpText" DockPanel.Dock="Top" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,14" Text="检测到多个 Steam 库，请选择要使用的 Cut the Rope。" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CancelButton" Click="CancelButton_Click" Content="取消" />
            <Button x:Name="ConfirmButton" Click="ConfirmButton_Click" Content="使用此位置" IsDefault="True" />
        </StackPanel>
        <ListBox x:Name="InstallationsList" DisplayMemberPath="DisplayText" />
    </DockPanel>
</Window>
