<Window x:Class="CutTheSave.App.ReadmeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="README" Width="820" Height="680" MinWidth="620" MinHeight="480" WindowStartupLocation="CenterOwner" Background="{DynamicResource PageBackgroundBrush}">
    <Window.Style><Style TargetType="Window" BasedOn="{StaticResource {x:Type Window}}" /></Window.Style>
    <DockPanel Margin="24">
        <TextBlock x:Name="ReadmeTitle" DockPanel.Dock="Top" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,14" Text="Cut the Save README" />
        <Button x:Name="CloseButton" DockPanel.Dock="Bottom" HorizontalAlignment="Right" Width="100" Margin="0,14,0,0" Click="CloseButton_Click" Content="关闭" IsCancel="True" />
        <TextBox x:Name="ReadmeText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FontSize="14" Padding="16" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" />
    </DockPanel>
</Window>
