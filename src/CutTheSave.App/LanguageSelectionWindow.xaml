<Window x:Class="CutTheSave.App.LanguageSelectionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="选择语言" Width="500" Height="330" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="{DynamicResource PageBackgroundBrush}">
    <Window.Style><Style TargetType="Window" BasedOn="{StaticResource {x:Type Window}}" /></Window.Style>
    <StackPanel Margin="32">
        <TextBlock x:Name="TitleText" FontSize="25" FontWeight="SemiBold" Text="选择语言" />
        <TextBlock x:Name="RecommendationText" Margin="0,10,0,22" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
        <TextBlock x:Name="LanguageLabel" FontWeight="SemiBold" Text="界面语言" />
        <ComboBox x:Name="LanguageComboBox" Margin="0,8,0,24" Height="34" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="UseRecommendedButton" Click="UseRecommendedButton_Click" Content="使用推荐语言" />
            <Button x:Name="ConfirmButton" Click="ConfirmButton_Click" Content="确定" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" />
        </StackPanel>
    </StackPanel>
</Window>
