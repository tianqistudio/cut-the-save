<Window x:Class="CutTheSave.App.BackupsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{DynamicResource {x:Type Window}}"
        Title="Backups" Width="1100" Height="620" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PageBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" FontSize="24" FontWeight="SemiBold" Text="Backups" />
        <TextBlock x:Name="HelpText" Grid.Row="1" Margin="0,6,0,10" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
        <TextBlock x:Name="RetentionText" Grid.Row="2" Margin="0,0,0,14" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
        <DataGrid x:Name="BackupsGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="DateColumn" Header="Date" Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="170" MinWidth="170" />
                <DataGridCheckBoxColumn x:Name="LockedColumn" Header="Locked" Binding="{Binding IsLocked, Mode=OneWay}" Width="80" MinWidth="80" />
                <DataGridTextColumn x:Name="SizeColumn" Header="Size (bytes)" Binding="{Binding FileSize, StringFormat=N0}" Width="125" MinWidth="125" />
                <DataGridTextColumn x:Name="ReasonColumn" Header="Reason" Binding="{Binding Reason}" Width="135" MinWidth="135" />
                <DataGridTextColumn x:Name="OriginalColumn" Header="Original file" Binding="{Binding OriginalPath}" Width="*" MinWidth="180">
                    <DataGridTextColumn.CellStyle><Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Setter Property="ToolTip" Value="{Binding OriginalPath}" /></Style></DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name="HashColumn" Header="SHA-256" Binding="{Binding Sha256}" Width="*" MinWidth="170">
                    <DataGridTextColumn.CellStyle><Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Setter Property="ToolTip" Value="{Binding Sha256}" /></Style></DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="StatusText" Grid.Row="4" Margin="0,12,0,4" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
        <WrapPanel Grid.Row="5" HorizontalAlignment="Right">
            <Button x:Name="RefreshButton" Click="RefreshButton_Click" Content="Refresh" />
            <Button x:Name="RecoverButton" Click="RecoverButton_Click" Content="Repair records" Visibility="Collapsed" />
            <Button x:Name="SaveRecoveryButton" Click="SaveRecoveryButton_Click" Visibility="Collapsed"/>
            <Button x:Name="CopyHashButton" Click="CopyHashButton_Click" Content="Copy hash" IsEnabled="False" />
            <Button x:Name="OpenFolderButton" Click="OpenFolderButton_Click" Content="Open folder" IsEnabled="False" />
            <Button x:Name="LockButton" Click="LockButton_Click" Content="Lock" IsEnabled="False" />
            <Button x:Name="CleanupButton" Click="CleanupButton_Click" Content="Clean expired" IsEnabled="False" />
            <Button x:Name="RestoreButton" Click="RestoreButton_Click" Content="Restore selected" IsEnabled="False" />
            <Button x:Name="CloseButton" Click="CloseButton_Click" Content="Close" IsCancel="True" />
        </WrapPanel>
    </Grid>
</Window>
